rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Assumed data model (matches Android app):
    // - users/{userId}
    //     fields: credits, email, displayName, createdAt, updatedAt
    // - users/{userId}/history/{completionId}
    //     quiz completion records (scores + questions for download)
    // - users/{userId}/credit_ledger/{entryId}
    //     append-only credit deduction entries
    // - users/{userId}/quizzes/{quizId}
    //     legacy path (kept for older builds)

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Starting balance must match CreditPolicy.STARTING_CREDITS in the Android app.
    function hasStartingCredits() {
      return request.resource.data.credits == 10000;
    }

    // Client may lower credits (deduction) or leave them unchanged, but cannot raise them.
    // If the existing doc has no credits field, only the starting balance may be written.
    function creditsNotIncreased() {
      return !('credits' in request.resource.data)
        || (
          ('credits' in resource.data)
            ? request.resource.data.credits <= resource.data.credits
            : request.resource.data.credits == 10000
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // First-time user doc creation (ensureUserDoc).
      allow create: if isOwner(userId) && hasStartingCredits();

      // Profile/credit updates. Deduction transactions decrease credits.
      // LIMITATION: ownership-scoped client writes cannot fully stop a rooted
      // client from writing crafted lower balances; true credit integrity needs
      // a trusted backend (Cloud Functions / Admin SDK) which requires Blaze.
      allow update: if isOwner(userId) && creditsNotIncreased();

      allow delete: if false;

      match /history/{completionId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /credit_ledger/{entryId} {
        // App only creates ledger rows; treat as append-oriented.
        allow read, create: if isOwner(userId);
        allow update, delete: if false;
      }

      // Legacy path from earlier builds
      match /quizzes/{quizId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }
  }
}
