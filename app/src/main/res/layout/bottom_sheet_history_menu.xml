<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_90sdp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/bottom_sheet_menu_image" />

    <TextView
        android:id="@+id/tvMenuTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/inter_bold"
        android:text="Quiz actions"
        android:textColor="@color/qm_text_primary"
        android:textSize="@dimen/_15sdp" />

    <TextView
        android:id="@+id/btnGiveAgain"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:gravity="center_vertical"
        android:fontFamily="@font/inter_semi_bold"
        android:text="Give Quiz Again"
        android:textColor="@color/qm_text_primary"
        android:textSize="@dimen/_13sdp" />

    <TextView
        android:id="@+id/btnDownload"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:gravity="center_vertical"
        android:fontFamily="@font/inter_semi_bold"
        android:text="Download Quiz"
        android:textColor="@color/qm_text_primary"
        android:textSize="@dimen/_13sdp" />

    <TextView
        android:id="@+id/btnShare"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:gravity="center_vertical"
        android:fontFamily="@font/inter_semi_bold"
        android:text="Share Result"
        android:textColor="@color/qm_text_primary"
        android:textSize="@dimen/_13sdp" />

    <TextView
        android:id="@+id/btnRename"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:gravity="center_vertical"
        android:fontFamily="@font/inter_semi_bold"
        android:text="Rename"
        android:textColor="@color/qm_text_primary"
        android:textSize="@dimen/_13sdp" />

    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:gravity="center_vertical"
        android:fontFamily="@font/inter_semi_bold"
        android:text="Delete"
        android:textColor="#DC2626"
        android:textSize="@dimen/_13sdp" />

</LinearLayout>
