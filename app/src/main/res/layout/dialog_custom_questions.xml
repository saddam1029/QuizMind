<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Number of Questions"
        android:textSize="@dimen/_15sdp"
        android:fontFamily="@font/inter_semi_bold"
        android:textColor="@color/qm_text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose between 3 and 25 questions."
        android:textSize="@dimen/_11sdp"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/qm_text_secondary"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginBottom="@dimen/_12sdp" />

    <EditText
        android:id="@+id/etCustomQuestions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:background="@drawable/bg_search_input"
        android:paddingHorizontal="@dimen/_12sdp"
        android:hint="e.g. 8"
        android:textColorHint="@color/qm_text_secondary"
        android:textColor="@color/qm_text_primary"
        android:textSize="@dimen/_14sdp"
        android:fontFamily="@font/inter_medium"
        android:inputType="number"
        android:maxLength="2" />

</LinearLayout>
