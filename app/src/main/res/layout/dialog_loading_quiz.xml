<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/_20sdp">

    <TextView
        android:id="@+id/tvLoadingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semi_bold"
        android:gravity="center"
        android:text="Crafting Your Quiz with AI..."
        android:textColor="@color/qm_text_primary"
        android:textSize="@dimen/_15sdp" />

    <TextView
        android:id="@+id/tvLoadingSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:text="Gemini is analyzing your topic and designing smart questions."
        android:textColor="@color/qm_text_secondary"
        android:textSize="@dimen/_11sdp" />

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerCreateQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        app:shimmer_auto_start="true"
        app:shimmer_base_alpha="0.7"
        app:shimmer_duration="1200"
        app:shimmer_highlight_alpha="1.0"
        app:shimmer_tilt="12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/item_create_quiz_skeleton" />

            <include
                layout="@layout/item_create_quiz_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

</LinearLayout>
