<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_10sdp"
    android:background="@drawable/bg_history_card">

    <View
        android:id="@+id/boneIcon"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/bg_skeleton_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/boneTitle"
        android:layout_width="0dp"
        android:layout_height="@dimen/_12sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:background="@drawable/bg_skeleton_bone"
        app:layout_constraintEnd_toStartOf="@id/boneScore"
        app:layout_constraintStart_toEndOf="@id/boneIcon"
        app:layout_constraintTop_toTopOf="@id/boneIcon" />

    <LinearLayout
        android:id="@+id/boneMetaRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/boneScore"
        app:layout_constraintStart_toStartOf="@id/boneTitle"
        app:layout_constraintTop_toBottomOf="@id/boneTitle">

        <View
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_14sdp"
            android:background="@drawable/bg_skeleton_bone" />

        <View
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/bg_skeleton_bone" />

        <View
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/bg_skeleton_bone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/boneScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_12sdp"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/boneIcon">

        <View
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_16sdp"
            android:background="@drawable/bg_skeleton_bone" />

        <View
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="@drawable/bg_skeleton_bone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/boneFooter"
        android:layout_width="0dp"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/bg_history_footer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/boneIcon">

        <View
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:background="@drawable/bg_skeleton_circle" />

        <View
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_skeleton_bone" />

        <View
            android:layout_width="@dimen/_52sdp"
            android:layout_height="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/bg_skeleton_bone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
