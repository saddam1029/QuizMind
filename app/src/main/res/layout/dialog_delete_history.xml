<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="@dimen/_20sdp">

    <FrameLayout
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:background="@drawable/bg_delete_icon_circle">

        <ImageView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_remove" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:fontFamily="@font/inter_bold"
        android:text="Delete quiz?"
        android:textColor="@color/qm_text_primary"
        android:textSize="@dimen/_16sdp" />

    <TextView
        android:id="@+id/tvDeleteMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/inter_regular"
        android:lineSpacingExtra="2dp"
        android:text="This quiz and its result will be permanently removed."
        android:textColor="@color/qm_text_secondary"
        android:textSize="@dimen/_12sdp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelDelete"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:fontFamily="@font/inter_semi_bold"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="@color/app_color"
            android:textSize="@dimen/_13sdp" />

        <TextView
            android:id="@+id/btnConfirmDelete"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_delete"
            android:fontFamily="@font/inter_semi_bold"
            android:gravity="center"
            android:text="Delete"
            android:textColor="@color/white"
            android:textSize="@dimen/_13sdp" />
    </LinearLayout>

</LinearLayout>
