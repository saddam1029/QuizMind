<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="@dimen/_20sdp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="Rename quiz"
        android:textColor="@color/qm_text_primary"
        android:textSize="@dimen/_16sdp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:fontFamily="@font/inter_regular"
        android:text="Choose a clear name you'll recognize later."
        android:textColor="@color/qm_text_secondary"
        android:textSize="@dimen/_12sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:fontFamily="@font/inter_semi_bold"
        android:text="Quiz name"
        android:textColor="@color/app_color"
        android:textSize="@dimen/_11sdp" />

    <EditText
        android:id="@+id/etRename"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_46sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:background="@drawable/bg_input_blue_stroke"
        android:fontFamily="@font/inter_regular"
        android:hint="Quiz name"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:paddingHorizontal="@dimen/_12sdp"
        android:textColor="@color/qm_text_primary"
        android:textColorHint="@color/qm_text_secondary"
        android:textSize="@dimen/_13sdp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelRename"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:fontFamily="@font/inter_semi_bold"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="@color/app_color"
            android:textSize="@dimen/_13sdp" />

        <TextView
            android:id="@+id/btnSaveRename"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="@font/inter_semi_bold"
            android:gravity="center"
            android:text="Save"
            android:textColor="@color/white"
            android:textSize="@dimen/_13sdp" />
    </LinearLayout>

</LinearLayout>
